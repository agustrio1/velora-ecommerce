# =============================================================================
# VELORA — environment configuration template
# Copy to `.env` (frontend, Vite) and `.dev.vars` (Worker local secrets).
# Production secrets go to Cloudflare Worker Secrets:
#   bunx wrangler secret put DUITKU_API_KEY
# NEVER commit real credentials. NEVER expose backend secrets to the frontend.
# =============================================================================

# -----------------------------------------------------------------------------
# FRONTEND (Vite, public by design — safe for the browser bundle)
# Source: Firebase console > Project settings > General > Your apps (Web app)
# -----------------------------------------------------------------------------
VITE_APP_NAME=VELORA
VITE_APP_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8787/api
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_VAPID_KEY=

# -----------------------------------------------------------------------------
# BACKEND (Cloudflare Worker) — vars (non secret)
# Set in wrangler.toml [vars] or `--var KEY:VALUE`
# -----------------------------------------------------------------------------
APP_ENV=development
APP_URL=http://localhost:8787
LOG_LEVEL=info
BRAND_NAME=VELORA
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8787
MEDIA_PUBLIC_BASE_URL=http://localhost:8787/media

# -----------------------------------------------------------------------------
# BACKEND (Cloudflare Worker) — SECRETS ONLY (.dev.vars locally, Worker Secrets
# in production). Leave blank to run in sandbox / offline degradation mode.
# -----------------------------------------------------------------------------

# Duitku (payment gateway). DUITKU_ENVIRONMENT: sandbox | production
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
DUITKU_ENVIRONMENT=sandbox

# Biteship (shipping API). BITESHIP_ENVIRONMENT: sandbox | production
BITESHIP_API_KEY=
BITESHIP_ENVIRONMENT=sandbox

# Firebase service account — used ONLY server-side to mint OAuth2 access tokens
# for FCM HTTP v1 and Realtime Database REST (with Security Rules enforced).
# FIREBASE_PRIVATE_KEY must keep its \n escapes when pasted into a secret store.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Email provider (Resend or any transactional email API)
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=

# Internal defense-in-depth secret for webhook headers
WEBHOOK_SIGNING_SECRET=
